// Prisma schema for CertGuard (PostgreSQL / Supabase Database)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("ORGANIZER") // "ADMIN" | "ORGANIZER"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  events       Event[]       @relation("OrganizerEvents")
  templates    Template[]    @relation("CreatedTemplates")
  certificates Certificate[] @relation("CreatedCertificates")

  @@map("users")
}

model Event {
  id          String        @id @default(uuid())
  name        String
  description String?
  date        DateTime
  category    String        @default("WORKSHOP") // "WORKSHOP" | "COMPETITION" | "TRAINING" | "OTHER"
  organizerId String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organizer   User          @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  certificates Certificate[]

  @@map("events")
}

model Template {
  id          String        @id @default(uuid())
  name        String
  imagePath   String?       // Background image relative path
  fieldLayout String        // JSON string storing array of field positioning & styling rules
  isDefault   Boolean       @default(false)
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  creator     User          @relation("CreatedTemplates", fields: [createdBy], references: [id], onDelete: Cascade)
  certificates Certificate[]

  @@map("templates")
}

model Certificate {
  id             String            @id @default(uuid())
  certCode       String            @unique // e.g. CERT-2026-X89A12
  eventId        String
  recipientName  String
  recipientEmail String
  issueDate      DateTime          @default(now())
  hash           String            // SHA-256 hash of core cert data
  pdfPath        String            // Local PDF file path
  qrPath         String?           // Local QR PNG path
  status         String            @default("VALID") // "VALID" | "REVOKED"
  templateId     String
  createdBy      String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  template       Template          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  creator        User              @relation("CreatedCertificates", fields: [createdBy], references: [id], onDelete: Cascade)
  verificationLogs VerificationLog[]

  @@map("certificates")
}

model VerificationLog {
  id            String      @id @default(uuid())
  certificateId String
  verifiedAt    DateTime    @default(now())
  ipAddress     String?
  userAgent     String?
  statusChecked String      // VALID / REVOKED / HASH_MATCHED

  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@map("verification_logs")
}
